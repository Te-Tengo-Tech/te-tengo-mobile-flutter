# Upload key for release builds (docs/RELEASE_ANDROID.md). Copy to android/key.properties, which is
# gitignored, and never commit the real file or the keystore. Without it, release builds are signed
# with the debug key and Google Play rejects them.
#
# Create the keystore once (keep a backup and the passwords in the team's password manager):
#   keytool -genkeypair -v -keystore android/app/upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
# Path relative to android/app/
storeFile=upload-keystore.jks
