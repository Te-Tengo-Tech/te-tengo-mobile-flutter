<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget 2 × 2 (US-44, prototype `widget(st, '2')`): state only, never images. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_fondo_calma">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/foto"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <TextView
                android:id="@+id/iniciales"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_avatar"
                android:gravity="center"
                android:textColor="#7A2456"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- The older adult's photo, over the initials when the app saved one. -->
            <ImageView
                android:id="@+id/retrato"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/insignia"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/widget_insignia_calma"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/widget_ico_check" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />
    </LinearLayout>

    <TextView
        android:id="@+id/titulo"
        android:text="@string/widget_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_tinta"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/linea"
        android:text="@string/widget_cargando"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_tinta2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ver_en_vivo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/widget_boton"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/widget_ico_video"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_ver_en_vivo"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
