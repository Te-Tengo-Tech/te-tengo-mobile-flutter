<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget 4 × 2 (US-44, prototype `widget(st, '4')`): state only, never images. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_fondo_calma">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/marca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_nombre"
            android:textColor="@color/widget_tinta"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actualizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_tinta"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/foto"
            android:layout_width="60dp"
            android:layout_height="60dp">

            <TextView
                android:id="@+id/iniciales"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_avatar"
                android:gravity="center"
                android:textColor="#7A2456"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- The older adult's photo, over the initials when the app saved one. -->
            <ImageView
                android:id="@+id/retrato"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/insignia"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/widget_insignia_calma"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/widget_ico_check" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titulo"
            android:text="@string/widget_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_tinta"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linea"
            android:text="@string/widget_cargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_tinta2"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ver_en_vivo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_boton"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/widget_ico_video"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/widget_ver_en_vivo"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
