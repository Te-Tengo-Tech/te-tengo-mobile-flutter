  "@legalPoliticaQuienTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaQuienTexto": "Solo la familia vinculada. Cada acceso en vivo y cada repetición quedan en un registro que ven todos: quién, cuándo y cuánto.",
  "@legalPoliticaQuienTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
