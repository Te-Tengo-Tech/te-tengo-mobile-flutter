  },
  "consentimientoSeccionVivoTexto": "La familia vinculada puede verla en vivo cuando quiera, no solo en una alerta. Cada acceso queda registrado: quién, cuándo y cuánto.",
  "@consentimientoSeccionVivoTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionHacemosTitulo": "Qué hacemos",
  "@consentimientoSeccionHacemosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionHacemosResumen": "Caídas por la postura",
  "@consentimientoSeccionHacemosResumen": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionHacemosTexto": "La PC de la casa analiza la postura para detectar caídas y movimientos inestables. El video continuo nunca sale de la casa. Solo salen el aviso y el clip de cada alerta, y la vista en vivo mientras alguien de la familia la mira.",
  "@consentimientoSeccionHacemosTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionNoHacemosTitulo": "Qué no hacemos",
  "@consentimientoSeccionNoHacemosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionNoHacemosResumen": "Ni rostros ni grabación continua",
  "@consentimientoSeccionNoHacemosResumen": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionNoHacemosTexto": "Sin reconocimiento facial ni grabación continua. La vista en vivo no se guarda.",
  "@consentimientoSeccionNoHacemosTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionGuardamosTitulo": "Qué guardamos",
  "@consentimientoSeccionGuardamosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionGuardamosResumen": "Clip de cada alerta, 30 días",
  "@consentimientoSeccionGuardamosResumen": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionGuardamosTexto": "Solo el clip de cada alerta, 30 días; luego se borra. Se guarda en Microsoft Azure (Azure Blob Storage, región Chile Central), con servidores fuera del Perú: es un flujo transfronterizo de datos personales. Sus movimientos (puntos del cuerpo, sin imagen) solo se guardan con un permiso aparte.",
  "@consentimientoSeccionGuardamosTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionDerechosTitulo": "Sus derechos",
  "@consentimientoSeccionDerechosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionDerechosResumen": "Ley N.° 29733 · revocable",
  "@consentimientoSeccionDerechosResumen": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoSeccionDerechosTexto": "Por la Ley N.° 29733, puede ver, corregir o borrar sus datos, oponerse a su uso y revocar este consentimiento.",
  "@consentimientoSeccionDerechosTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoRegistroTitulo": "Cómo se registra",
  "@consentimientoRegistroTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "consentimientoRegistroTexto": "Guardamos quién lo otorgó, quién lo registró, fecha y hora (Ley N.° 29733).",
  "@consentimientoRegistroTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosQueEsTitulo": "Qué es Te Tengo",
  "@legalTerminosQueEsTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosQueEsTexto": "Avisa a tu familia si la cámara de la casa detecta una posible caída o un movimiento inestable. No es una cámara de seguridad.",
  "@legalTerminosQueEsTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosCuentaTitulo": "Tu cuenta",
  "@legalTerminosCuentaTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosCuentaTexto1": "Solo el titular (quien la crea) cambia los datos de la persona cuidada, el consentimiento, las habitaciones, la familia y el orden de aviso.",
  "@legalTerminosCuentaTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosCuentaTexto2": "Cada cuenta cuida a una sola persona. Contraseña de 8 caracteres o más, con un número; 5 intentos fallidos bloquean el acceso 15 minutos.",
  "@legalTerminosCuentaTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosInvitadosTitulo": "Familiares invitados",
  "@legalTerminosInvitadosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosInvitadosTexto": "Ven alertas, clips, historial y vista en vivo; marcan alertas y pausan la cámara. El titular puede retirar el acceso.",
  "@legalTerminosInvitadosTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosConsentimientoTitulo": "Consentimiento",
  "@legalTerminosConsentimientoTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosConsentimientoTexto1": "Sin el consentimiento de la persona cuidada o de su representante legal, la cámara no envía video. Revocarlo detiene la captura y borra las grabaciones.",
  "@legalTerminosConsentimientoTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosConsentimientoTexto2": "Guardar sus movimientos necesita un permiso aparte y opcional; las alertas funcionan igual sin él.",
  "@legalTerminosConsentimientoTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosAlertasTitulo": "Alertas",
  "@legalTerminosAlertasTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosAlertasTexto": "Las reciben todos los familiares vinculados. Si el principal no marca una en el tiempo de espera (3, 5 o 10 minutos), avisamos al secundario.",
  "@legalTerminosAlertasTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosLimitesTitulo": "Límites del servicio",
  "@legalTerminosLimitesTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosLimitesTexto1": "Sin detección con la PC de la casa apagada, la cámara desconectada, en pausa o sin consentimiento; no es confiable si no ve bien a la persona.",
  "@legalTerminosLimitesTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalTerminosLimitesTexto2": "Con la app cerrada, las alertas llegan solo con las notificaciones activadas.",
  "@legalTerminosLimitesTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDatosTitulo": "Qué datos guardamos",
  "@legalPoliticaDatosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDatosTexto1": "Cuenta: nombre, correo y contraseña.",
  "@legalPoliticaDatosTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDatosTexto2": "Persona cuidada: nombre, edad, dirección y con quién vive.",
  "@legalPoliticaDatosTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDatosTexto3": "Alertas: tipo, habitación, fecha, hora y quién atendió.",
  "@legalPoliticaDatosTexto3": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaVideoTitulo": "Video",
  "@legalPoliticaVideoTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaVideoTexto1": "Se analiza en la PC de la casa. Sin reconocimiento facial ni video en la nube.",
  "@legalPoliticaVideoTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaVideoTexto2": "Solo salen de la casa el aviso y el clip de cada alerta, y la vista en vivo mientras alguien de la familia la mira con el consentimiento vigente.",
  "@legalPoliticaVideoTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaVideoTexto3": "Solo el clip de cada alerta (6 s antes y 6 s después), 30 días. La vista en vivo no se graba.",
  "@legalPoliticaVideoTexto3": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaMovimientosTitulo": "Movimientos",
  "@legalPoliticaMovimientosTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaMovimientosTexto1": "Solo con un permiso aparte y opcional: puntos del cuerpo (hombros, caderas, rodillas…), sin imagen ni video.",
  "@legalPoliticaMovimientosTexto1": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaMovimientosTexto2": "En la PC de la casa y, si el titular lo elige, en la nube, de 7 días a 1 año. Retirar el permiso borra los de la nube; la PC pregunta si también los borra.",
  "@legalPoliticaMovimientosTexto2": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDondeTitulo": "Dónde se guardan",
  "@legalPoliticaDondeTitulo": {
    "description": "LEGAL: needs human/legal review in English."
  },
  "legalPoliticaDondeTexto": "Los clips y los movimientos de la nube se guardan en Microsoft Azure (Azure Blob Storage, región Chile Central), con servidores fuera del Perú: es un flujo transfronterizo de datos personales.",
  "@legalPoliticaDondeTexto": {
    "description": "LEGAL: needs human/legal review in English."
  },
